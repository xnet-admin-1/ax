#!/bin/bash
# AX Web API Test Automation Script
# Usage: ./test_api.sh [base_url] [test_key]

set -euo pipefail

# Configuration
BASE_URL=${1:-"http://localhost:8080"}
TEST_KEY=${2:-"dev-key-123"}
TEST_AGENT_KEY=${3:-"ci-key-456"}

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Counters
TOTAL=0
PASSED=0
FAILED=0

# Test function
test_endpoint() {
    local name=$1
    local method=$2
    local endpoint=$3
    local headers=$4
    local data=$5
    local expected_status=${6:-200}
    local expected_key=${7:-""}

    TOTAL=$((TOTAL + 1))
    echo -e "\n${YELLOW}Testing: $name${NC}"
    echo "Endpoint: $method $endpoint"
    if [ -n "$data" ]; then
        echo "Request Data: $data"
    fi

    local response
    local status_code

    if [ "$method" = "GET" ]; then
        response=$(curl -s -o /dev/stderr -w "%{http_code}" \
                   -X $method \
                   ${headers:+$headers} \
                   "$BASE_URL$endpoint")
        status_code=$response
    else
        response=$(curl -s -o /dev/stderr -w "%{http_code}" \
                   -X $method \
                   ${headers:+$headers} \
                   -d "$data" \
                   "$BASE_URL$endpoint")
        status_code=$response
    fi

    if [ "$status_code" -eq "$expected_status" ]; then
        if [ -n "$expected_key" ]; then
            if grep -q "\"$expected_key\""