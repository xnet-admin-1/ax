### 4.2 Critical Code Additions
```go
// internal/serve/tools.go
package serve

type ToolHandler struct {
    engine *engine.Engine
}

func (h *ToolHandler) ExecuteTool(w http.ResponseWriter, r *http.Request) {
    var req struct {
        Tool      string                 `json:"tool"`
        Parameters map[string]interface{} `json:"parameters"`
        Trust    bool                   `json:"trust"`
    }
    json.NewDecoder(r.Body).Decode(&req)

    if err := validateTrust(req.Tool, r); err != nil {
        http.Error(w, err.Error(), http.StatusForbidden)
        return
    }

    result, err := h.engine.ExecuteTool(r.Context(), req.Tool, req.Parameters)
    if err != nil {
        http.Error(w, err.Error(), http.StatusInternalServerError)
        return
    }

    json.NewEncoder(w).Encode(result)
}
```

